@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var todayLabel = Model.Today.ToString("MMMM d, yyyy");
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Muscle Memory Dashboard</h1>
        <p class="text-secondary mb-0">Gym overview for @todayLabel (Philippine time)</p>
    </div>
    <a class="btn btn-outline-primary" asp-page="/Reports/Index">View Reports</a>
</div>

<section class="mb-4" aria-labelledby="overview-heading">
    <h2 id="overview-heading" class="h5 mb-3">Overview</h2>
    <div class="row g-3">
        <div class="col-6 col-xl-3">
            <div class="card dashboard-stat-card h-100">
                <div class="card-body">
                    <div class="text-secondary small">Registered members</div>
                    <div class="display-6 fw-semibold">@Model.TotalMembers</div>
                    <div class="small text-secondary">@Model.ActiveMembers active · @Model.InactiveMembers inactive</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card dashboard-stat-card h-100">
                <div class="card-body">
                    <div class="text-secondary small">Membership plans</div>
                    <div class="display-6 fw-semibold">@Model.TotalPlans</div>
                    <div class="small text-secondary">@Model.ActivePlans active · @Model.InactivePlans inactive</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card dashboard-stat-card h-100">
                <div class="card-body">
                    <div class="text-secondary small">Today's attendance</div>
                    <div class="display-6 fw-semibold">@Model.TodayAttendanceCount</div>
                    <div class="small text-secondary">@Model.CurrentlyCheckedIn currently checked in</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="card dashboard-stat-card h-100">
                <div class="card-body">
                    <div class="text-secondary small">Collected this month</div>
                    <div class="h3 fw-semibold mb-1">₱@Model.MonthlyCollectedRevenue.ToString("N2")</div>
                    <div class="small text-secondary">@Model.MonthlyPaymentCount payments recorded</div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="row g-4 mb-4">
    <section class="col-lg-6" aria-labelledby="activity-heading">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 id="activity-heading" class="h5 mb-0">Recent Members</h2>
                <a class="small" asp-page="/Members/Index">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Member</th><th>Plan</th><th>Join date</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                    @if (Model.RecentMembers.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-secondary py-4">No members have registered yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var member in Model.RecentMembers)
                        {
                            <tr>
                                <td><span class="fw-semibold">@member.FirstName @member.LastName</span><div class="small text-secondary">@member.Email</div></td>
                                <td>@member.Plan.PlanName</td>
                                <td>@member.JoinDate.ToString("MMM d, yyyy")</td>
                                <td><span class="badge @(member.Status == "active" ? "text-bg-success" : "text-bg-secondary")">@Model.DisplayStatus(member.Status)</span></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="col-lg-6" aria-labelledby="payments-heading">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 id="payments-heading" class="h5 mb-0">Recent Payments</h2>
                <a class="small" asp-page="/Payments/Index">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Member / Plan</th><th>Amount</th><th>Date</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                    @if (Model.RecentPayments.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-secondary py-4">No payments have been recorded yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var payment in Model.RecentPayments)
                        {
                            <tr>
                                <td><span class="fw-semibold">@payment.Member.FirstName @payment.Member.LastName</span><div class="small text-secondary">@payment.Plan.PlanName</div></td>
                                <td>₱@payment.Amount.ToString("N2")</td>
                                <td>@payment.PaymentDate.ToString("MMM d, yyyy")<div class="small text-secondary">@payment.PaymentMethod</div></td>
                                <td><span class="badge @(payment.Status == "paid" ? "text-bg-success" : "text-bg-secondary")">@Model.DisplayStatus(payment.Status)</span></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<div class="row g-4 mb-4">
    <section class="col-lg-6" aria-labelledby="attendance-heading">
        <div class="card h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h2 id="attendance-heading" class="h5 mb-0">Recent Attendance</h2>
                <a class="small" asp-page="/Attendance/Index">View all</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>Member</th><th>Date</th><th>Check-in</th><th>Check-out</th><th>Status</th></tr>
                    </thead>
                    <tbody>
                    @if (Model.RecentAttendance.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-secondary py-4">No attendance records have been recorded yet.</td></tr>
                    }
                    else
                    {
                        @foreach (var record in Model.RecentAttendance)
                        {
                            <tr>
                                <td>@record.Member.FirstName @record.Member.LastName</td>
                                <td>@record.AttendanceDate.ToString("MMM d, yyyy")</td>
                                <td>@record.CheckInTime</td>
                                <td>@(record.CheckOutTime ?? "—")</td>
                                <td><span class="badge @(record.CheckOutTime is null ? "text-bg-warning" : "text-bg-success")">@(record.CheckOutTime is null ? "Checked in" : "Checked out")</span></td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white small text-secondary">
                @Model.TodayCheckedOut attendance records dated today with a check-out time
            </div>
        </div>
    </section>

    <section class="col-lg-6" aria-labelledby="plan-breakdown-heading">
        <div class="card h-100">
            <div class="card-header bg-white">
                <h2 id="plan-breakdown-heading" class="h5 mb-0">Members by Membership Plan</h2>
            </div>
            <div class="card-body">
                @if (Model.PlanDistribution.Count == 0)
                {
                    <p class="text-secondary mb-0">No membership plans are available yet.</p>
                }
                else
                {
                    @foreach (var plan in Model.PlanDistribution)
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between gap-2 mb-1">
                                <span>@plan.PlanName</span>
                                <span class="text-secondary">@plan.MemberCount members · @plan.Percentage.ToString("0.#")%</span>
                            </div>
                            <div class="progress" role="progressbar" aria-label="@($"{plan.PlanName} members")" aria-valuenow="@plan.Percentage.ToString("0.#")" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: @plan.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </section>
</div>

<section class="card mb-4" aria-labelledby="quick-actions-heading">
    <div class="card-body">
        <h2 id="quick-actions-heading" class="h5 mb-3">Quick Actions</h2>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-primary" asp-page="/Members/Create">Add Member</a>
            <a class="btn btn-outline-primary" asp-page="/Payments/Create">Record Payment</a>
            <a class="btn btn-outline-primary" asp-page="/Attendance/Index">Check In Member</a>
            <a class="btn btn-outline-primary" asp-page="/Plans/Create">Create Membership Plan</a>
        </div>
    </div>
</section>

<section class="card" aria-labelledby="payment-status-heading">
    <div class="card-body">
        <h2 id="payment-status-heading" class="h5 mb-3">Payment Amounts This Month</h2>
        @if (Model.MonthlyPaymentStatuses.Count == 0)
        {
            <p class="text-secondary mb-0">No payments recorded this month.</p>
        }
        else
        {
            <div class="row g-3">
                @foreach (var status in Model.MonthlyPaymentStatuses)
                {
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-3 h-100">
                            <div class="text-secondary small">@Model.DisplayStatus(status.Status) (@status.Count)</div>
                            <div class="fw-semibold">₱@status.Amount.ToString("N2")</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
