@page
@model GymManagementSystem.Pages.DataManagement.IndexModel
@{
    ViewData["Title"] = "Data Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Data Management</h1>
        <p class="text-secondary mb-0">Review record counts and carefully remove gym business data.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Index">Back to Dashboard</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="alert alert-warning" role="alert">
    <h2 class="h6 alert-heading">Create a backup before deleting data</h2>
    <p class="mb-1">These operations are permanent. The application does not create an automatic backup because the database location and a safe persistent backup location are not configured.</p>
    <p class="mb-0">Before proceeding, stop the application and create a verified SQLite backup outside the public web directory. Keep the backup somewhere separate from the application deployment.</p>
</div>

<div class="row g-3">
    <section class="col-lg-6" aria-labelledby="clear-attendance-heading">
        <div class="card h-100">
            <div class="card-body">
                <h2 id="clear-attendance-heading" class="h5">Clear Attendance Records</h2>
                <p class="text-secondary">Attendance history is permanently removed. Member and payment records are not affected.</p>
                <p class="fs-5 fw-semibold mb-3">Current records: @Model.AttendanceCount</p>
                <form method="post" asp-page-handler="ClearAttendance">
                    <div class="form-check mb-3">
                        <input asp-for="ConfirmAttendanceClear" class="form-check-input" />
                        <label asp-for="ConfirmAttendanceClear" class="form-check-label">I understand this permanently removes attendance history.</label>
                    </div>
                    <button type="submit" class="btn btn-outline-danger">Clear Attendance Records</button>
                </form>
            </div>
        </div>
    </section>

    <section class="col-lg-6" aria-labelledby="clear-payments-heading">
        <div class="card h-100">
            <div class="card-body">
                <h2 id="clear-payments-heading" class="h5">Clear Payment Records</h2>
                <p class="text-secondary">Payment history is permanently removed. Member and plan records are not affected.</p>
                <p class="fs-5 fw-semibold mb-3">Current records: @Model.PaymentCount</p>
                <form method="post" asp-page-handler="ClearPayments">
                    <div class="form-check mb-3">
                        <input asp-for="ConfirmPaymentClear" class="form-check-input" />
                        <label asp-for="ConfirmPaymentClear" class="form-check-label">I understand this permanently removes payment history.</label>
                    </div>
                    <button type="submit" class="btn btn-outline-danger">Clear Payment Records</button>
                </form>
            </div>
        </div>
    </section>

    <section class="col-lg-6" aria-labelledby="clear-members-heading">
        <div class="card h-100">
            <div class="card-body">
                <h2 id="clear-members-heading" class="h5">Clear Members</h2>
                <p class="text-secondary">Members can only be cleared after attendance and payment history has been cleared. Related records are never deleted silently.</p>
                <p class="fs-5 fw-semibold mb-1">Current members: @Model.MemberCount</p>
                <p class="small text-secondary">Attendance records: @Model.AttendanceCount · Payment records: @Model.PaymentCount</p>
                @if (Model.AttendanceCount > 0 || Model.PaymentCount > 0)
                {
                    <div class="alert alert-warning mb-0" role="status">Clear attendance and payment records first. The server will recheck before deletion.</div>
                }
                else
                {
                    <form method="post" asp-page-handler="ClearMembers">
                        <div class="form-check mb-3">
                            <input asp-for="ConfirmMemberClear" class="form-check-input" />
                            <label asp-for="ConfirmMemberClear" class="form-check-label">I understand these member records will be permanently removed.</label>
                        </div>
                        <button type="submit" class="btn btn-outline-danger">Clear Members</button>
                    </form>
                }
            </div>
        </div>
    </section>

    <section class="col-lg-6" aria-labelledby="clear-plans-heading">
        <div class="card h-100">
            <div class="card-body">
                <h2 id="clear-plans-heading" class="h5">Clear Membership Plans</h2>
                <p class="text-secondary">Plans cannot be removed while member or payment records reference them.</p>
                <p class="fs-5 fw-semibold mb-1">Current plans: @Model.PlanCount</p>
                <p class="small text-secondary">Members: @Model.PlanMemberReferenceCount · Payments: @Model.PlanPaymentReferenceCount</p>
                @if (Model.PlanMemberReferenceCount > 0 || Model.PlanPaymentReferenceCount > 0)
                {
                    <div class="alert alert-warning mb-0" role="status">Clear member and payment records first. The server will recheck before deletion.</div>
                }
                else
                {
                    <form method="post" asp-page-handler="ClearPlans">
                        <div class="form-check mb-3">
                            <input asp-for="ConfirmPlanClear" class="form-check-input" />
                            <label asp-for="ConfirmPlanClear" class="form-check-label">I understand these membership plans will be permanently removed.</label>
                        </div>
                        <button type="submit" class="btn btn-outline-danger">Clear Membership Plans</button>
                    </form>
                }
            </div>
        </div>
    </section>
</div>

<section class="card border-danger mt-4" aria-labelledby="full-reset-heading">
    <div class="card-header bg-danger text-white">
        <h2 id="full-reset-heading" class="h5 mb-0">Full System Reset</h2>
    </div>
    <div class="card-body">
        <p class="fw-semibold">This permanently erases all gym business data.</p>
        <p>The reset removes records in this order: attendance, payments, members, then membership plans. It preserves the database file, all four tables and their schema, and administrator authentication configuration.</p>
        <div class="table-responsive mb-4">
            <table class="table table-sm table-bordered mb-0">
                <thead class="table-light"><tr><th>Table</th><th class="text-end">Records to be erased</th></tr></thead>
                <tbody>
                    <tr><td>Attendance</td><td class="text-end">@Model.AttendanceCount</td></tr>
                    <tr><td>Payments</td><td class="text-end">@Model.PaymentCount</td></tr>
                    <tr><td>Members</td><td class="text-end">@Model.MemberCount</td></tr>
                    <tr><td>Membership plans</td><td class="text-end">@Model.PlanCount</td></tr>
                </tbody>
            </table>
        </div>
        <form method="post" asp-page-handler="Reset">
            <div class="mb-3">
                <label asp-for="ResetPhrase" class="form-label fw-semibold">Type <code>RESET GYM DATABASE</code> to continue</label>
                <input asp-for="ResetPhrase" class="form-control" autocomplete="off" spellcheck="false" />
            </div>
            <div class="form-check mb-3">
                <input asp-for="ConfirmReset" class="form-check-input" />
                <label asp-for="ConfirmReset" class="form-check-label">I have a verified backup and understand this will permanently erase all gym business data.</label>
            </div>
            <button type="submit" class="btn btn-danger">Reset All Gym Data</button>
        </form>
    </div>
</section>
