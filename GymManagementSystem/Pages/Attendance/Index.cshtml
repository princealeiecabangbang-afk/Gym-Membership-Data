@page
@model GymManagementSystem.Pages.Attendance.IndexModel
@{
    ViewData["Title"] = "Attendance";
}

<div class="mb-4">
    <h1 class="h2 mb-1">Attendance</h1>
    <p class="text-secondary mb-0">Record member check-ins and check-outs.</p>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5">Check in a member</h2>
                <p class="text-secondary small">The current date and time will be recorded automatically.</p>
                <form method="post" asp-page-handler="CheckIn">
                    <label asp-for="CheckInMemberId" class="form-label">Active member</label>
                    <select asp-for="CheckInMemberId" class="form-select mb-3">
                        <option value="0">Select a member</option>
                        @foreach (var member in Model.EligibleMembers)
                        {
                            <option value="@member.MemberId">
                                @member.FirstName @member.LastName — @member.Email (ID @member.MemberId)
                            </option>
                        }
                    </select>
                    @if (Model.EligibleMembers.Count == 0)
                    {
                        <div class="form-text mb-3">No eligible active members are available to check in.</div>
                    }
                    <button type="submit" class="btn btn-primary" disabled="@(Model.EligibleMembers.Count == 0)">Check In</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5">Check out a member</h2>
                <p class="text-secondary small">Members already checked in, including inactive members, can check out.</p>
                <form method="post" asp-page-handler="CheckOut">
                    <label asp-for="CheckOutAttendanceId" class="form-label">Open check-in</label>
                    <select asp-for="CheckOutAttendanceId" class="form-select mb-3">
                        <option value="0">Select a checked-in member</option>
                        @foreach (var record in Model.OpenRecords)
                        {
                            <option value="@record.AttendanceId">
                                @record.Member.FirstName @record.Member.LastName — @record.Member.Email
                                (since @record.CheckInTime)
                            </option>
                        }
                    </select>
                    @if (Model.OpenRecords.Count == 0)
                    {
                        <div class="form-text mb-3">There are no members waiting to check out.</div>
                    }
                    <button type="submit" class="btn btn-outline-primary" disabled="@(Model.OpenRecords.Count == 0)">Check Out</button>
                </form>
            </div>
        </div>
    </div>
</div>

<form method="get" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label asp-for="SearchTerm" class="form-label">Search member</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Name or email" />
        </div>
        <div class="col-sm-6 col-md-3">
            <label asp-for="DateFilter" class="form-label">Attendance date</label>
            <input asp-for="DateFilter" class="form-control" type="date" />
        </div>
        <div class="col-sm-6 col-md-2">
            <label asp-for="StatusFilter" class="form-label">Status</label>
            <select asp-for="StatusFilter" class="form-select">
                <option value="">All statuses</option>
                <option value="checked-in">Checked in</option>
                <option value="checked-out">Checked out</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
            <a class="btn btn-outline-secondary" asp-page="./Index">Clear</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Member</th>
                    <th scope="col">Date</th>
                    <th scope="col">Check-in</th>
                    <th scope="col">Check-out</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Records.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">
                            No attendance records found. Check in a member to get started.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var record in Model.Records)
                    {
                        <tr>
                            <td>@record.AttendanceId</td>
                            <td>
                                <span class="fw-semibold">@record.Member.FirstName @record.Member.LastName</span>
                                <div class="small text-secondary">@record.Member.Email</div>
                            </td>
                            <td>@record.AttendanceDate.ToString("yyyy-MM-dd")</td>
                            <td>@record.CheckInTime</td>
                            <td>@(record.CheckOutTime ?? "—")</td>
                            <td>
                                @if (record.CheckOutTime is null)
                                {
                                    <span class="badge text-bg-warning">Checked in</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">Checked out</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end flex-wrap gap-2">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@record.AttendanceId">View</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@record.AttendanceId">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
