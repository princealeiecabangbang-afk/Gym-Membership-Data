@page "{id:int}"
@model GymManagementSystem.Pages.Members.DetailsModel
@{
    ViewData["Title"] = "Member details";
}

<div class="mb-4">
    <a class="text-decoration-none" asp-page="Index">&larr; Back to members</a>
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-2">
        <div>
            <h1 class="h2 mb-1">@Model.Member!.FirstName @Model.Member.LastName</h1>
            <p class="text-secondary mb-0">Member ID: @Model.Member.MemberId</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-page="Edit" asp-route-id="@Model.Member.MemberId">Edit member</a>
            <a class="btn btn-outline-secondary" asp-page="Index">Done</a>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <dl class="row card-body mb-0">
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Member.Email</dd>
        <dt class="col-sm-3">Phone</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Member.Phone) ? "Not provided" : Model.Member.Phone)</dd>
        <dt class="col-sm-3">Date of birth</dt>
        <dd class="col-sm-9">@(Model.Member.DateOfBirth?.ToString("yyyy-MM-dd") ?? "Not provided")</dd>
        <dt class="col-sm-3">Gender</dt>
        <dd class="col-sm-9">@(Model.Member.Gender ?? "Not specified")</dd>
        <dt class="col-sm-3">Membership plan</dt>
        <dd class="col-sm-9">@Model.Member.Plan.PlanName</dd>
        <dt class="col-sm-3">Join date</dt>
        <dd class="col-sm-9">@Model.Member.JoinDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@($"{char.ToUpperInvariant(Model.Member.Status[0])}{Model.Member.Status[1..]}")</dd>
    </dl>
</div>
