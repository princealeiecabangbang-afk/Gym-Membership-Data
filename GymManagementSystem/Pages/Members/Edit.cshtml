@page "{id:int}"
@model GymManagementSystem.Pages.Members.EditModel
@{
    ViewData["Title"] = "Edit member";
}

<div class="mb-4">
    <a class="text-decoration-none" asp-page="Index">&larr; Back to members</a>
    <h1 class="h2 mt-2 mb-1">Edit member</h1>
    <p class="text-secondary mb-0">Update the member's information below.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            <partial name="_MemberForm" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
