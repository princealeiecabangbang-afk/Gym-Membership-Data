@page
@model GymManagementSystem.Pages.Members.IndexModel
@{
    ViewData["Title"] = "Members";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Members</h1>
        <p class="text-secondary mb-0">Register members and manage their membership information.</p>
    </div>
    <a class="btn btn-primary" asp-page="Create">Add a member</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label asp-for="SearchTerm" class="form-label">Search members</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Name or email" />
        </div>
        <div class="col-sm-6 col-md-3">
            <label asp-for="StatusFilter" class="form-label">Status</label>
            <select asp-for="StatusFilter" class="form-select">
                <option value="">All statuses</option>
                @foreach (var status in Model.Statuses)
                {
                    <option value="@status">@($"{char.ToUpperInvariant(status[0])}{status[1..]}")</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-md-3">
            <label asp-for="PlanFilter" class="form-label">Membership plan</label>
            <select asp-for="PlanFilter" class="form-select">
                <option value="">All plans</option>
                @foreach (var plan in Model.Plans)
                {
                    <option value="@plan.PlanId">@plan.PlanName</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
            <a class="btn btn-outline-secondary" asp-page="./Index">Clear</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Member</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Plan</th>
                    <th scope="col">Join date</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Members.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-secondary py-5">
                            No members found. Add a member or adjust your search filters.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var member in Model.Members)
                    {
                        <tr>
                            <td>@member.MemberId</td>
                            <td>
                                <span class="fw-semibold">@member.FirstName @member.LastName</span>
                                <div class="small text-secondary">@member.Email</div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(member.Phone) ? "—" : member.Phone)</td>
                            <td>@member.Plan.PlanName</td>
                            <td>@member.JoinDate.ToString("yyyy-MM-dd")</td>
                            <td>
                                <span class="badge @(member.Status == "active" ? "text-bg-success" : "text-bg-secondary")">
                                    @($"{char.ToUpperInvariant(member.Status[0])}{member.Status[1..]}")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex justify-content-end flex-wrap gap-2">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@member.MemberId">View</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@member.MemberId">Edit</a>
                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@member.MemberId">
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                                        <input type="hidden" name="PlanFilter" value="@Model.PlanFilter" />
                                        <button type="submit" class="btn btn-sm btn-outline-dark">
                                            @(member.Status == "active" ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@member.MemberId">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
