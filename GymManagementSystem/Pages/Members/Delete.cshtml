@page "{id:int}"
@model GymManagementSystem.Pages.Members.DeleteModel
@{
    ViewData["Title"] = "Delete member";
}

<div class="mb-4">
    <a class="text-decoration-none" asp-page="Index">&larr; Back to members</a>
    <h1 class="h2 mt-2 mb-1">Delete member</h1>
    <p class="text-secondary mb-0">Review the member before confirming.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        <h2 class="h5">@Model.Member!.FirstName @Model.Member.LastName</h2>
        <p class="text-secondary">@Model.Member.Email · @Model.Member.Plan.PlanName</p>

        @if (Model.AttendanceCount > 0 || Model.PaymentCount > 0)
        {
            <div class="alert alert-warning" role="alert">
                This member cannot be deleted because they have
                @Model.AttendanceCount attendance record(s) and @Model.PaymentCount payment record(s).
                Historical records will be kept.
            </div>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                This action cannot be undone. There are no attendance or payment records linked to this member.
            </div>
        }

        <div class="d-flex gap-2">
            @if (Model.AttendanceCount == 0 && Model.PaymentCount == 0)
            {
                <form method="post">
                    <div class="form-check mb-3">
                        <input asp-for="ConfirmDelete" class="form-check-input" />
                        <label asp-for="ConfirmDelete" class="form-check-label">I understand this member will be permanently deleted.</label>
                    </div>
                    <button type="submit" class="btn btn-danger">Delete member</button>
                </form>
            }
            <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
        </div>
    </div>
</div>
