@page "{id:int}"
@model GymManagementSystem.Pages.Payments.DetailsModel
@{
    ViewData["Title"] = "Payment details";
}

<div class="mb-4">
    <a class="text-decoration-none" asp-page="Index">&larr; Back to payments</a>
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-2">
        <div>
            <h1 class="h2 mb-1">Payment #@Model.Payment!.PaymentId</h1>
            <p class="text-secondary mb-0">Payment details and associated records</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-page="Edit" asp-route-id="@Model.Payment.PaymentId">Edit payment</a>
            <a class="btn btn-outline-secondary" asp-page="Index">Done</a>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <dl class="row card-body mb-0">
        <dt class="col-sm-3">Member</dt>
        <dd class="col-sm-9">@Model.Payment.Member.FirstName @Model.Payment.Member.LastName (ID @Model.Payment.MemberId)</dd>
        <dt class="col-sm-3">Member email</dt>
        <dd class="col-sm-9">@Model.Payment.Member.Email</dd>
        <dt class="col-sm-3">Membership plan</dt>
        <dd class="col-sm-9">@Model.Payment.Plan.PlanName</dd>
        <dt class="col-sm-3">Amount</dt>
        <dd class="col-sm-9">@Model.Payment.Amount.ToString("0.00")</dd>
        <dt class="col-sm-3">Payment date</dt>
        <dd class="col-sm-9">@Model.Payment.PaymentDate.ToString("yyyy-MM-dd")</dd>
        <dt class="col-sm-3">Payment method</dt>
        <dd class="col-sm-9">@Model.Payment.PaymentMethod</dd>
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@($"{char.ToUpperInvariant(Model.Payment.Status[0])}{Model.Payment.Status[1..]}")</dd>
        <dt class="col-sm-3">Receipt number</dt>
        <dd class="col-sm-9">@(Model.Payment.ReceiptNumber ?? "Not provided")</dd>
    </dl>
</div>
