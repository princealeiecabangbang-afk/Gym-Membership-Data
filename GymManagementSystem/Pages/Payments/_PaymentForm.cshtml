@model GymManagementSystem.Pages.Payments.PaymentFormModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Input.MemberId" class="form-label">Member <span class="text-danger">*</span></label>
        <select asp-for="Input.MemberId" class="form-select">
            <option value="0">Select a member</option>
            @foreach (var member in Model.Members)
            {
                <option value="@member.MemberId">@member.FirstName @member.LastName — @member.Email (ID @member.MemberId)</option>
            }
        </select>
        <span asp-validation-for="Input.MemberId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.PlanId" class="form-label">Membership plan <span class="text-danger">*</span></label>
        <select asp-for="Input.PlanId" class="form-select">
            <option value="0">Select a plan</option>
            @foreach (var plan in Model.Plans)
            {
                <option value="@plan.PlanId">@plan.PlanName (@plan.Price.ToString("0.00"))</option>
            }
        </select>
        <span asp-validation-for="Input.PlanId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Amount" class="form-label">Amount <span class="text-danger">*</span></label>
        <input asp-for="Input.Amount" class="form-control" type="number" min="0" max="99999999.99" step="0.01" />
        <span asp-validation-for="Input.Amount" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.PaymentDate" class="form-label">Payment date <span class="text-danger">*</span></label>
        <input asp-for="Input.PaymentDate" class="form-control" type="date" />
        <span asp-validation-for="Input.PaymentDate" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.PaymentMethod" class="form-label">Payment method <span class="text-danger">*</span></label>
        <select asp-for="Input.PaymentMethod" class="form-select">
            <option value="">Select a method</option>
            <option value="Cash">Cash</option>
            <option value="Card">Card</option>
            <option value="Bank Transfer">Bank Transfer</option>
            <option value="Mobile Money">Mobile Money</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="Input.PaymentMethod" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Status" class="form-label">Status <span class="text-danger">*</span></label>
        <select asp-for="Input.Status" class="form-select">
            <option value="paid">Paid</option>
            <option value="pending">Pending</option>
            <option value="failed">Failed</option>
            <option value="refunded">Refunded</option>
        </select>
        <span asp-validation-for="Input.Status" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Input.ReceiptNumber" class="form-label">Receipt number <span class="text-secondary">(optional)</span></label>
        <input asp-for="Input.ReceiptNumber" class="form-control" autocomplete="off" />
        <span asp-validation-for="Input.ReceiptNumber" class="text-danger"></span>
    </div>
</div>
