@page
@model GymManagementSystem.Pages.Payments.IndexModel
@{
    ViewData["Title"] = "Payments";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Payments</h1>
        <p class="text-secondary mb-0">Record and review member payment history.</p>
    </div>
    <a class="btn btn-primary" asp-page="Create">Record a payment</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label asp-for="SearchTerm" class="form-label">Search payments</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Member name, email, or receipt" />
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="DateFilter" class="form-label">Payment date</label>
            <input asp-for="DateFilter" class="form-control" type="date" />
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="StatusFilter" class="form-label">Status</label>
            <select asp-for="StatusFilter" class="form-select">
                <option value="">All statuses</option>
                @foreach (var status in Model.Statuses)
                {
                    <option value="@status">@($"{char.ToUpperInvariant(status[0])}{status[1..]}")</option>
                }
            </select>
        </div>
        <div class="col-sm-6 col-lg-2">
            <label asp-for="MethodFilter" class="form-label">Method</label>
            <select asp-for="MethodFilter" class="form-select">
                <option value="">All methods</option>
                @foreach (var method in Model.Methods)
                {
                    <option value="@method">@method</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
            <a class="btn btn-outline-secondary" asp-page="./Index">Clear</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Member</th>
                    <th scope="col">Plan</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Date</th>
                    <th scope="col">Method</th>
                    <th scope="col">Status</th>
                    <th scope="col">Receipt</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payments.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center text-secondary py-5">
                            No payments found. Record a payment to get started.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var payment in Model.Payments)
                    {
                        <tr>
                            <td>@payment.PaymentId</td>
                            <td>
                                <span class="fw-semibold">@payment.Member.FirstName @payment.Member.LastName</span>
                                <div class="small text-secondary">@payment.Member.Email</div>
                            </td>
                            <td>@payment.Plan.PlanName</td>
                            <td>@payment.Amount.ToString("0.00")</td>
                            <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                            <td>@payment.PaymentMethod</td>
                            <td><span class="badge text-bg-secondary">@($"{char.ToUpperInvariant(payment.Status[0])}{payment.Status[1..]}")</span></td>
                            <td>@(payment.ReceiptNumber ?? "—")</td>
                            <td>
                                <div class="d-flex justify-content-end flex-wrap gap-2">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@payment.PaymentId">View</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@payment.PaymentId">Edit</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@payment.PaymentId">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
