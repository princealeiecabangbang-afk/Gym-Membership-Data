@page "{id:int}"
@model GymManagementSystem.Pages.Payments.EditModel
@{
    ViewData["Title"] = "Edit payment";
}

<div class="mb-4">
    <a class="text-decoration-none" asp-page="Index">&larr; Back to payments</a>
    <h1 class="h2 mt-2 mb-1">Edit payment #@RouteData.Values["id"]</h1>
    <p class="text-secondary mb-0">Update the payment details. The payment ID will remain unchanged.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form method="post">
            <partial name="_PaymentForm" model="Model" />
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-secondary" asp-page="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
