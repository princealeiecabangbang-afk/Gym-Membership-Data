@page
@model GymManagementSystem.Pages.Plans.IndexModel
@{
    ViewData["Title"] = "Membership Plans";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Membership Plans</h1>
        <p class="text-secondary mb-0">Create and manage the plans offered by your gym.</p>
    </div>
    <a class="btn btn-primary" asp-page="Create">Add a plan</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-sm-8 col-md-6">
            <label asp-for="SearchTerm" class="form-label">Search by plan name</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="For example, Standard" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary">Search</button>
            <a class="btn btn-outline-secondary" asp-page="./Index">Clear</a>
        </div>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Plan</th>
                    <th scope="col">Duration</th>
                    <th scope="col">Price</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Plans.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">
                            No plans found. Add a plan to get started.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var plan in Model.Plans)
                    {
                        <tr>
                            <td>
                                <span class="fw-semibold">@plan.PlanName</span>
                                @if (!string.IsNullOrWhiteSpace(plan.Description))
                                {
                                    <div class="small text-secondary">@plan.Description</div>
                                }
                            </td>
                            <td>@plan.DurationDays days</td>
                            <td>@plan.Price.ToString("0.00")</td>
                            <td>
                                @if (plan.IsActive)
                                {
                                    <span class="badge text-bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex justify-content-end flex-wrap gap-2">
                                    <a class="btn btn-sm btn-outline-secondary" asp-page="Details" asp-route-id="@plan.PlanId">View</a>
                                    <a class="btn btn-sm btn-outline-primary" asp-page="Edit" asp-route-id="@plan.PlanId">Edit</a>
                                    <form method="post" asp-page-handler="Toggle" asp-route-id="@plan.PlanId">
                                        <input type="hidden" name="SearchTerm" value="@Model.SearchTerm" />
                                        <button type="submit" class="btn btn-sm btn-outline-dark">
                                            @(plan.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>
                                    <a class="btn btn-sm btn-outline-danger" asp-page="Delete" asp-route-id="@plan.PlanId">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
