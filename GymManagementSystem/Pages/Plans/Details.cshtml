@page "{id:int}"
@model GymManagementSystem.Pages.Plans.DetailsModel
@{
    ViewData["Title"] = "Plan details";
}

<div class="mb-4">
    <a class="text-decoration-none" asp-page="Index">&larr; Back to plans</a>
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-2">
        <div>
            <h1 class="h2 mb-1">@Model.Plan!.PlanName</h1>
            <p class="text-secondary mb-0">Membership plan details</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-page="Edit" asp-route-id="@Model.Plan.PlanId">Edit plan</a>
            <a class="btn btn-outline-secondary" asp-page="Index">Done</a>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <dl class="row card-body mb-0">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @if (Model.Plan.IsActive)
            {
                <span class="badge text-bg-success">Active</span>
            }
            else
            {
                <span class="badge text-bg-secondary">Inactive</span>
            }
        </dd>
        <dt class="col-sm-3">Duration</dt>
        <dd class="col-sm-9">@Model.Plan.DurationDays days</dd>
        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Plan.Price.ToString("0.00")</dd>
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Plan.Description) ? "No description provided." : Model.Plan.Description)</dd>
        <dt class="col-sm-3">Members using this plan</dt>
        <dd class="col-sm-9">@Model.MemberCount</dd>
        <dt class="col-sm-3">Payments using this plan</dt>
        <dd class="col-sm-9">@Model.PaymentCount</dd>
    </dl>
</div>
