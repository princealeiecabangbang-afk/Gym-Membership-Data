@model GymManagementSystem.Pages.Plans.PlanInput

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-8">
        <label asp-for="PlanName" class="form-label">Plan name <span class="text-danger">*</span></label>
        <input asp-for="PlanName" class="form-control" autocomplete="off" />
        <span asp-validation-for="PlanName" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="DurationDays" class="form-label">Duration (days) <span class="text-danger">*</span></label>
        <input asp-for="DurationDays" class="form-control" type="number" min="1" />
        <span asp-validation-for="DurationDays" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Price" class="form-label">Price <span class="text-danger">*</span></label>
        <input asp-for="Price" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-6 d-flex align-items-end pb-2">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Plan is active</label>
        </div>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label">Description <span class="text-secondary">(optional)</span></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>

